generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING_QR
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
}

enum MessageStatus {
  RECEIVED
  AUTO_REPLIED
  FLAGGED_FOR_REVIEW
  SKIPPED
}

enum RuleAction {
  SKIP_REPLY
  FORCE_GREETING
  FORCE_CATEGORY
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ActorType {
  SUPER_ADMIN
  TENANT
}

// ALL replies to anyone not explicitly blocked; ALLOWLIST replies only to contacts
// listed with ALLOW. Blocked contacts are ignored under both policies.
enum ContactPolicy {
  ALL
  ALLOWLIST
}

enum ContactFilterType {
  ALLOW
  BLOCK
}

// How the assistant behaves in group chats. MENTIONED_ONLY is the useful middle
// ground: stay silent in the group unless someone @-mentions this number.
enum GroupReplyMode {
  NEVER
  MENTIONED_ONLY
  ALWAYS
}

model Tenant {
  id              String       @id @default(uuid())
  name            String
  apiKey          String       @unique @default(uuid())
  rateLimitMinutes Int         @default(1440)
  loginEmail      String?      @unique
  passwordHash    String?
  status          TenantStatus @default(ACTIVE)

  // Persona: who the assistant presents itself as. Without these the model answers
  // "what is your name" with its own model name (observed: "I'm Gemma").
  assistantName       String?
  ownerName           String?
  businessInfo        String?
  personaInstructions String?

  // Reply targeting
  replyToDirect        Boolean        @default(true)
  groupReplyMode       GroupReplyMode @default(NEVER)
  greetingsOnly        Boolean       @default(false)
  contactPolicy        ContactPolicy @default(ALL)
  // Safety net against auto-responder ping-pong: max auto-replies to one contact per
  // rolling hour, independent of rateLimitMinutes.
  autoReplyBurstLimit  Int           @default(5)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions        WhatsAppSession[]
  messageLogs     MessageLog[]
  correctionRules CorrectionRule[]
  contactFilters  ContactFilter[]

  @@map("tenants")
}

model WhatsAppSession {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label       String?
  status      SessionStatus @default(PENDING_QR)
  phoneNumber String?
  qrCode      String?
  disconnectNotifiedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tenantId, id])
  @@map("whatsapp_sessions")
}

model ContactFilter {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Bare WhatsApp JID as it arrives on the message (e.g. "6591234567@s.whatsapp.net").
  jid       String
  type      ContactFilterType
  label     String?
  createdAt DateTime          @default(now())

  @@unique([tenantId, jid])
  @@index([tenantId, type])
  @@map("contact_filters")
}

model MessageLog {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId         String
  remoteJid         String
  // WhatsApp display name of the sender (Baileys msg.pushName), used to personalize
  // replies. Absent for broadcasts and some group events.
  senderName        String?
  // Whether this message @-mentioned the tenant's own number. Resolved at capture
  // time from the live socket's identity; it cannot be recovered afterwards.
  mentionsMe        Boolean       @default(false)
  direction         String        @default("INBOUND")
  messageType       String
  rawText           String?
  mediaBase64       String?       @db.Text
  isGreetingOrWish  Boolean?
  isForwardedContent Boolean?
  confidenceScore   Float?
  detectedLanguage  String?
  suggestedReply    String?
  finalReply        String?
  matchedRuleId     String?
  status            MessageStatus @default(RECEIVED)
  reviewedByAdmin   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, remoteJid])
  @@index([tenantId, status])
  @@map("message_logs")
}

model CorrectionRule {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pattern     String
  isRegex     Boolean    @default(true)
  action      RuleAction
  forcedReply String?
  category    String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, active])
  @@map("correction_rules")
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String
  action     String
  targetType String
  targetId   String
  tenantId   String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  actorType ActorType
  actorId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([actorType, actorId])
  @@map("password_reset_tokens")
}
